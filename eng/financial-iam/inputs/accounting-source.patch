+    [Fact]
+    public async Task MissingIamProfileStopsRegisteredTransportWithoutCallingLegacyProviderOrNetwork()
+    {
+        var builder = Compose();
+        var missing = new Mock<ILegacyIamServiceAccessTokenProvider>(MockBehavior.Strict);
+        missing.Setup(value => value.GetAccessTokenAsync(It.IsAny<CancellationToken>()))
+            .Returns(new ValueTask<string?>((string?)null));
+        var legacy = new Mock<ILegacyServiceAccessTokenProvider>(MockBehavior.Strict);
+        builder.Services.AddSingleton(missing.Object);
+        builder.Services.AddSingleton(legacy.Object);
+        var network = new CountingNetwork();
+        builder.Services.AddHttpClient("IAMService").ConfigurePrimaryHttpMessageHandler(() => network);
+        using var provider = builder.Services.BuildServiceProvider();
+        using var client = provider.GetRequiredService<IHttpClientFactory>().CreateClient("IAMService");
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/iam/v1/auth/check-permission");
+        var failure = await Assert.ThrowsAsync<HttpRequestException>(() => client.SendAsync(request));
+        Assert.Equal(HttpStatusCode.ServiceUnavailable, failure.StatusCode);
+        Assert.Equal(0, network.Calls);
+        missing.Verify(value => value.GetAccessTokenAsync(It.IsAny<CancellationToken>()), Times.Once);
+        legacy.VerifyNoOtherCalls();
