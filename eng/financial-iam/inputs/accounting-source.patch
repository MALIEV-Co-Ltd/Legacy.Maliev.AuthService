+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using Microsoft.IdentityModel.Tokens;
+using Moq;
+using Npgsql;
+using Testcontainers.PostgreSql;
+using Docker.DotNet;
+using System.Runtime.ExceptionServices;
+
+[assembly: CollectionBehavior(DisableTestParallelization = true)]
+
+namespace Accounting.PermissionRegistration.Tests;
+
+// Real source issuer, persisted IAM catalogue/principal/role/binding and actual resolver.
+// This is the ordinary service-account email enrollment path, not managed-workload or HTTP join acceptance.
+public sealed class OrdinaryFinancialPrincipalTests : IClassFixture<OrdinaryFinancialPrincipalFixture>
+{
+    private const string Permission = "legacy.accounting-financial-ownership.read";
+    private readonly OrdinaryFinancialPrincipalFixture fixture;
+    public OrdinaryFinancialPrincipalTests(OrdinaryFinancialPrincipalFixture fixture) => this.fixture = fixture;
+
+    [Theory]
+    [InlineData("legacy-auth")]
+    [InlineData("legacy-quotation")]
+    public async Task OrdinaryEmailEnrollmentResolvesActualOpaqueJwtToPersistedGuidAndGlobalRead(string client)
+    {
+        await using var boundary = fixture.Open();
+        var account = await boundary.EnrollAsync(client);
+        await boundary.GrantAsync(account, null);
+        var subject = fixture.IssueAndValidateSubject(client, Permission);
+        Assert.Equal(account.PrincipalId, await boundary.Principals.ResolvePrincipalIdAsync(subject));
+        var response = await boundary.CheckAsync(subject);
+        Assert.True(response.Allowed);
+        Assert.Equal(account.PrincipalId, response.PrincipalId);
+        Assert.Equal("global", response.ResourcePath);
+        Assert.False(response.FromCache);
+        Assert.Null(account.WorkloadId);
+        Assert.True(await boundary.Database.Principals.AsNoTracking().AnyAsync(row => row.PrincipalId == account.PrincipalId));
+    }
+
+    [Theory]
+    [InlineData("legacy-auth")]
+    [InlineData("legacy-quotation")]
+    public async Task TokenPermissionWithoutPersistedGrantIsDenied(string client)
+    {
+        await using var boundary = fixture.Open();
+        await boundary.EnrollAsync(client);
+        Assert.False((await boundary.CheckAsync(fixture.IssueAndValidateSubject(client, Permission))).Allowed);
+    }
+
+    [Theory]
+    [InlineData("legacy-auth")]
+    [InlineData("legacy-quotation")]
+    public async Task NonmatchingScopedBindingDoesNotAuthorizeIntentionalGlobalOperationRead(string client)
+    {
+        await using var boundary = fixture.Open();
+        var account = await boundary.EnrollAsync(client);
+        await boundary.GrantAsync(account, "operations/unrelated-fixture-operation");
+        Assert.False((await boundary.CheckAsync(fixture.IssueAndValidateSubject(client, Permission))).Allowed);
+    }
+
+    [Theory]
+    [InlineData("legacy-auth")]
+    [InlineData("legacy-quotation")]
+    public async Task OrdinaryRevocationRemovesRealBindingAndNextBypassCacheReadIsDenied(string client)
+    {
+        await using var boundary = fixture.Open();
+        var account = await boundary.EnrollAsync(client);
+        var binding = await boundary.GrantAsync(account, null);
+        var subject = fixture.IssueAndValidateSubject(client, Permission);
+        Assert.True((await boundary.CheckAsync(subject)).Allowed);
+        await boundary.Bindings.RevokeRoleAsync(account.PrincipalId, binding.BindingId, account.PrincipalId);
+        Assert.False(await boundary.Database.PrincipalRoleBindings.AsNoTracking().AnyAsync(row => row.BindingId == binding.BindingId));
+        Assert.False((await boundary.CheckAsync(subject)).Allowed);
+    }
+
+    [Theory]
+    [InlineData("legacy-auth")]
+    [InlineData("legacy-quotation")]
+    public async Task InactivePersistedOrdinaryPrincipalCannotUseItsExistingGlobalGrant(string client)
+    {
+        await using var boundary = fixture.Open();
+        var account = await boundary.EnrollAsync(client);
+        await boundary.GrantAsync(account, null);
+        account.IsActive = false;
+        await boundary.Principals.UpdateAsync(account);
+        Assert.False((await boundary.CheckAsync(fixture.IssueAndValidateSubject(client, Permission))).Allowed);
+    }
+
+    [Theory]
+    [InlineData("legacy-auth")]
+    [InlineData("legacy-quotation")]
+    public async Task UnenrolledOpaqueServiceSubjectFailsClosedWithoutAliasOrInventedGuid(string client)
+    {
+        await using var boundary = fixture.Open();
+        var subject = fixture.IssueAndValidateSubject(client, Permission);
+        await Assert.ThrowsAsync<InvalidOperationException>(() => boundary.Principals.ResolvePrincipalIdAsync(subject));
+        var response = await boundary.CheckAsync(subject);
+        Assert.False(response.Allowed);
+        Assert.Equal(Guid.Empty, response.PrincipalId);
+    }
+}
