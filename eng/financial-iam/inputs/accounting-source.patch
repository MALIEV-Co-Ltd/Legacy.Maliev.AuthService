diff --git a/Legacy.Maliev.AccountingService.Tests/AccountingIamProfileCompositionTests.cs b/Legacy.Maliev.AccountingService.Tests/AccountingIamProfileCompositionTests.cs
new file mode 100644
index 0000000..cd17adb
--- /dev/null
+++ b/Legacy.Maliev.AccountingService.Tests/AccountingIamProfileCompositionTests.cs
@@ -0,0 +1,89 @@
+using System.Net;
+using System.Reflection;
+using Legacy.Maliev.AccountingService.Api.Controllers.Invoice;
+using Maliev.Aspire.ServiceDefaults;
+using Maliev.Aspire.ServiceDefaults.LegacyAuth;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Hosting;
+using Moq;
+
+namespace Legacy.Maliev.AccountingService.Tests;
+
+public sealed class AccountingIamProfileCompositionTests
+{
+    [Fact]
+    public void RegisteredIamClientUsesSeparateIamHandlerAndGeneralClientRetainsLegacyHandler()
+    {
+        var builder = Compose();
+        builder.Services.AddHttpClient("FinancialLegacyProof").AddLegacyServiceAuthentication();
+        using var provider = builder.Services.BuildServiceProvider();
+        var factory = provider.GetRequiredService<IHttpMessageHandlerFactory>();
+        var iam = Chain(factory.CreateHandler("IAMService"));
+        var financial = Chain(factory.CreateHandler("FinancialLegacyProof"));
+        Assert.Single(iam, type => type == typeof(LegacyIamServiceAuthenticationHandler));
