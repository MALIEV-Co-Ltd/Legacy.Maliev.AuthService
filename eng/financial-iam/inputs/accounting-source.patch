index 78fb474..0f16974 100644
--- a/Legacy.Maliev.AccountingService.Api/Controllers/CrudController.cs
+++ b/Legacy.Maliev.AccountingService.Api/Controllers/CrudController.cs
@@ -2,6 +2,9 @@ using Legacy.Maliev.AccountingService.Application.Interfaces;
 using Legacy.Maliev.AccountingService.Application.Models;
 using Microsoft.AspNetCore.Mvc;
 using Microsoft.AspNetCore.Routing;
+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text.Json;
 
 namespace Legacy.Maliev.AccountingService.Api.Controllers;
 
@@ -11,6 +14,24 @@ public abstract class CrudController<T>(IAccountingService service, IIdempotency
 
     protected async Task<ActionResult<T>> Create(string scope, T item, string route, object routeValues, string? key, CancellationToken cancellationToken)
     {
+        if (!string.IsNullOrWhiteSpace(key))
+        {
+            var issuers = User.FindAll("iss").Select(claim => claim.Value).ToArray();
+            var subjects = User.FindAll("sub").Select(claim => claim.Value).ToArray();
+            if (subjects.Length == 0)
+            {
+                subjects = User.FindAll(ClaimTypes.NameIdentifier).Select(claim => claim.Value).ToArray();
+            }
+            if (User.Identity?.IsAuthenticated != true || issuers.Length != 1 || subjects.Length != 1
+                || string.IsNullOrWhiteSpace(issuers[0]) || string.IsNullOrWhiteSpace(subjects[0]))
+            {
+                return Forbid();
+            }
+
+            // Frame both signed identity fields before hashing; never read an unbound legacy memo.
+            var identity = JsonSerializer.SerializeToUtf8Bytes(new[] { issuers[0], subjects[0] });
+            scope = $"{scope}:caller-v1:{Convert.ToHexString(SHA256.HashData(identity))}";
+        }
         var value = await IdempotentCreates.GetOrCreateAsync(idempotency, scope, key,
             () => Service.CreateAsync(item, cancellationToken), cancellationToken);
         var values = new RouteValueDictionary(routeValues);
