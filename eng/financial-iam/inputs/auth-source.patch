+        using var response = await client.GetAsync("/iam/v1/principals/by-email/" + Uri.EscapeDataString(email), HttpCompletionOption.ResponseHeadersRead, token);
+        using var body = await ReadJsonAsync(response, HttpStatusCode.OK, token);
+        Assert.Equal(id, body.RootElement.GetProperty("principalId").GetGuid());
+        Assert.Equal(email, body.RootElement.GetProperty("email").GetString());
+        Assert.Equal(type, body.RootElement.GetProperty("principalType").GetString());
+        Assert.True(body.RootElement.GetProperty("isActive").GetBoolean());
+    }
+
+    private async Task<string> CreateRoleAsync(HttpClient client, string permission, CancellationToken token)
+    {
+        var roleId = "roles.legacy.financial-test-" + Guid.NewGuid().ToString("N");
+        using var response = await client.PostAsJsonAsync("/iam/v1/roles",
+            new { roleId, serviceName = "legacy", description = "Disposable least-privilege financial source qualification", permissionIds = new[] { permission } }, token);
+        using var body = await ReadJsonAsync(response, HttpStatusCode.Created, token);
+        Assert.Equal(roleId, body.RootElement.GetProperty("roleId").GetString());
+        Assert.Equal(permission, Assert.Single(body.RootElement.GetProperty("permissionIds").EnumerateArray()).GetString());
+        return roleId;
+    }
+
+    public async Task<Guid> GrantAsync(HttpClient client, Guid principal, string role, string? resource, DateTime expires, CancellationToken token)
+    {
+        using var response = await client.PostAsJsonAsync($"/iam/v1/principals/{principal:D}/roles", new { roleId = role, resourcePath = resource, expiresAt = expires }, token);
+        using var body = await ReadJsonAsync(response, HttpStatusCode.OK, token);
+        var id = body.RootElement.GetProperty("bindingId").GetGuid();
+        Assert.NotEqual(Guid.Empty, id);
+        Assert.Equal(principal, body.RootElement.GetProperty("principalId").GetGuid());
+        Assert.Equal(role, body.RootElement.GetProperty("roleId").GetString());
+        Assert.Equal(resource, body.RootElement.GetProperty("resourcePath").GetString());
+        Assert.Equal(expires, body.RootElement.GetProperty("expiresAt").GetDateTime());
+        await WriteLedgerAsync(new { run, purpose = "disposable ordinary binding", principal, bindingId = id, role,
+            resourcePath = resource, expiresAt = expires, livePolicyWrite = false }, token);
+        return id;
+    }
+
+    public async Task RevokeAsync(HttpClient client, Guid principal, Guid binding, CancellationToken token)
+    {
+        using var response = await client.DeleteAsync($"/iam/v1/principals/{principal:D}/roles/{binding:D}", token);
+        Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
+        using var readback = await client.GetAsync($"/iam/v1/principals/{principal:D}/roles", HttpCompletionOption.ResponseHeadersRead, token);
+        using var body = await ReadJsonAsync(readback, HttpStatusCode.OK, token);
+        Assert.DoesNotContain(body.RootElement.EnumerateArray(), item => item.GetProperty("bindingId").GetGuid() == binding);
+        await WriteLedgerAsync(new { run, purpose = "disposable ordinary binding", principal, bindingId = binding, state = "revoked-and-absent" }, token);
+    }
+
+    private async Task RegisterFrozenCatalogueAsync(HttpClient client, string producer, string expectedHash, CancellationToken token)
+    {
+        if (expectedHash.Length != 64 || expectedHash.Any(character => character is not (>= '0' and <= '9' or >= 'a' and <= 'f')))
+            throw new InvalidOperationException("A reviewed producer catalogue hash is required.");
+        var path = RequiredBinding(producer + "_CATALOGUE_PATH");
+        await using var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read, 4096, FileOptions.Asynchronous);
+        var bytes = new byte[65537];
+        var count = 0;
+        while (count < bytes.Length)
+        {
+            var read = await stream.ReadAsync(bytes.AsMemory(count), token);
+            if (read == 0) break;
+            count += read;
+        }
+        if (count is 0 or > 65536 || Convert.ToHexString(SHA256.HashData(bytes.AsSpan(0, count))).ToLowerInvariant() != expectedHash)
+            throw new InvalidOperationException("The exact frozen producer catalogue is unavailable.");
+        using var source = JsonDocument.Parse(bytes.AsMemory(0, count), new JsonDocumentOptions { MaxDepth = 16 });
+        Assert.Equal("legacy", source.RootElement.GetProperty("ServiceName").GetString());
+        var required = producer == "ACCOUNTING" ? "legacy.accounting-financial-ownership.read" : "legacy.quotations.update";
+        Assert.Contains(source.RootElement.GetProperty("Permissions").EnumerateArray(), item => item.GetProperty("PermissionId").GetString() == required);
+        using var response = await client.PostAsJsonAsync("/iam/v1/permissions/register", source.RootElement, token);
+        using var registered = await ReadJsonAsync(response, HttpStatusCode.OK, token);
+        using var readback = await client.GetAsync("/iam/v1/permissions/" + required, HttpCompletionOption.ResponseHeadersRead, token);
+        using var permission = await ReadJsonAsync(readback, HttpStatusCode.OK, token);
+        Assert.Equal(required, permission.RootElement.GetProperty("permissionId").GetString());
+        await WriteLedgerAsync(new { run, purpose = "exact producer catalogue registration", producer, sha256 = expectedHash,
+            method = "POST", path = "/iam/v1/permissions/register", sqlPositiveSeed = false }, token);
+    }
+
+    private static string RequiredBinding(string name) => Environment.GetEnvironmentVariable("ORDINARY_FINANCIAL_" + name)
+        ?? throw new InvalidOperationException("The explicit reviewed financial producer source binding is required.");
+
+    public static async Task<JsonDocument> ReadJsonAsync(HttpResponseMessage response, HttpStatusCode expected, CancellationToken token)
+    {
+        Assert.Equal(expected, response.StatusCode);
+        if (response.Content.Headers.ContentLength is > 32768) throw new InvalidOperationException("Owned HTTP response exceeds its bound.");
+        await using var stream = await response.Content.ReadAsStreamAsync(token);
+        var bytes = new byte[32769];
+        var count = 0;
+        while (count < bytes.Length)
+        {
+            var read = await stream.ReadAsync(bytes.AsMemory(count), token);
+            if (read == 0) break;
+            count += read;
+        }
+        if (count > 32768) throw new InvalidOperationException("Owned HTTP response exceeds its bound.");
+        return JsonDocument.Parse(bytes.AsMemory(0, count), new JsonDocumentOptions { MaxDepth = 16 });
+    }
+
+    private sealed class OwnedRouteFilter(AuthFactory factory) : IHttpMessageHandlerBuilderFilter
+    {
+        public Action<HttpMessageHandlerBuilder> Configure(Action<HttpMessageHandlerBuilder> next) => builder =>
+        {
+            next(builder);
+            if (builder.Name == Profile.HttpClientName)
+            {
+                builder.PrimaryHandler.Dispose();
+                builder.PrimaryHandler = new ExchangeRoute(factory.Server.CreateHandler(), factory);
+            }
+            else if (builder.Name == AuthApi::Legacy.Maliev.AuthService.Api.Authorization.QuotationInvoiceLiveAuthorityClient.HttpClientName)
+            {
+                builder.PrimaryHandler.Dispose();
+                builder.PrimaryHandler = new IamRoute(new HttpClientHandler { AllowAutoRedirect = false }, factory);
+            }
+            else if (builder.Name == "IAMService")
+            {
+                builder.PrimaryHandler.Dispose();
+                builder.PrimaryHandler = new NormalAuthIamRoute(new HttpClientHandler { AllowAutoRedirect = false }, factory);
+            }
+            else
+            {
+                builder.PrimaryHandler.Dispose();
+                builder.PrimaryHandler = new DeniedUnownedTransport(factory);
+            }
+        };
+    }
+
+    private sealed class ExchangeRoute(HttpMessageHandler inner, AuthFactory factory) : DelegatingHandler(inner)
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            Assert.Equal(Issuer, request.RequestUri!.GetLeftPart(UriPartial.Authority));
+            Assert.Contains(request.RequestUri.AbsolutePath, new[] { "/auth/v1/service/login", "/auth/v1/service/iam-login" });
+            Assert.Null(request.Headers.Authorization);
+            factory.ExchangePaths.Add(request.RequestUri.AbsolutePath);
+            return base.SendAsync(request, token);
+        }
+    }
+
+    private sealed class IamRoute(HttpMessageHandler inner, AuthFactory factory) : DelegatingHandler(inner)
+    {
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            Assert.Equal(IamAudience + "/iam/v1/auth/check-permission", request.RequestUri!.AbsoluteUri);
+            using var body = JsonDocument.Parse(await request.Content!.ReadAsStringAsync(token));
+            factory.CheckedSubjects.Add(body.RootElement.GetProperty("PrincipalId").GetString()!);
+            var jwt = new JwtSecurityTokenHandler().ReadJwtToken(request.Headers.Authorization!.Parameter!);
+            Assert.Equal("system:service:auth", jwt.Subject);
+            Assert.Equal(IamAudience, Assert.Single(jwt.Audiences));
+            Assert.Equal("AuthService", Assert.Single(jwt.Claims, claim => claim.Type == "service_name").Value);
+            Assert.Equal("iam.auth.check-permission", Assert.Single(jwt.Claims, claim => claim.Type == "permissions").Value);
+            // Owned transport substitution only: the response is actual loopback IAM HTTP.
+            // This lane does not claim real HTTPS certificate/TLS qualification.
+            request.RequestUri = new Uri(factory.IamAddress ?? throw new InvalidOperationException("Owned IAM host is not ready."), request.RequestUri.PathAndQuery);
+            return await base.SendAsync(request, token);
+        }
+    }
+
+    private sealed class NormalAuthIamRoute(HttpMessageHandler inner, AuthFactory factory) : DelegatingHandler(inner)
+    {
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            Assert.Equal(IamAudience + "/iam/v1/auth/check-permission", request.RequestUri!.AbsoluteUri);
+            using var body = JsonDocument.Parse(await request.Content!.ReadAsStringAsync(token));
+            var subject = body.RootElement.GetProperty("PrincipalId").GetString()!;
+            var permission = body.RootElement.GetProperty("PermissionId").GetString()!;
+            Assert.Equal("service:legacy-intranet", subject);
+            Assert.Equal("legacy-auth.invoice-delegation.issue", permission);
+            var jwt = new JwtSecurityTokenHandler().ReadJwtToken(request.Headers.Authorization!.Parameter!);
+            Assert.Equal("service:legacy-auth", jwt.Subject);
+            Assert.Equal(LegacyAudience, Assert.Single(jwt.Audiences));
+            Assert.DoesNotContain(jwt.Claims, claim => claim.Type == "service_name");
+            // The unchanged normal Auth IAM client uses an ordinary legacy bearer. The actual IAM host
+            // rejects its audience; standard (nonlive) authorization then uses the exact signed claim.
+            // This proves owned transport and real denial, not a positive IAM grant for bootstrap.
+            var destination = new Uri(factory.IamAddress ?? throw new InvalidOperationException("Owned normal IAM host is not ready."), request.RequestUri.PathAndQuery);
+            Assert.True(destination.IsLoopback);
+            Assert.Equal("http", destination.Scheme);
+            request.RequestUri = destination;
+            var response = await base.SendAsync(request, token);
+            factory.NormalIamChecks.Add((subject, permission, Assert.Single(jwt.Audiences), response.StatusCode));
+            return response;
+        }
+    }
+
+    private sealed class DeniedUnownedTransport(AuthFactory factory) : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            factory.DeniedUnownedRequests++;
+            return Task.FromException<HttpResponseMessage>(new InvalidOperationException("The owned Auth fixture forbids every unregistered external transport."));
+        }
+    }
+}
