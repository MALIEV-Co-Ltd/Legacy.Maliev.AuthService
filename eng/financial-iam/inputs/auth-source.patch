+    private async Task DisposeAuthHostAsync(bool enrollment, CancellationToken token)
+    {
+        var factory = enrollment ? EnrollmentAuth : Auth;
+        var startup = enrollment ? enrollmentStartup : authStartup;
+        if (factory is null) return;
+        if (startup is not null)
+        {
+            try
+            {
+                var key = await startup.WaitAsync(token);
+                if (enrollment) enrollmentAuthValidationRsa ??= key;
+                else authValidationRsa ??= key;
+            }
+            catch (Exception) when (startup.IsCompleted)
+            {
+                // Observe settled startup failure; it cannot suppress actual host disposal.
+                // The original initialization failure is preserved by InitializeAsync. Task settlement
+                // is not Program-entrypoint quiescence; quarantine is sticky until external owner exit.
+                if (enrollment) enrollmentStartupUncertain = true;
+                else authStartupUncertain = true;
+            }
+            if (!startup.IsCompleted) throw new InvalidOperationException("Actual owned Auth startup remains unsettled; retain its host and backend.");
+        }
+        var disposal = enrollment ? enrollmentAuthDisposal : authDisposal;
+        await disposal.WaitAsync(() => factory.DisposeAsync().AsTask(), token);
+        if (enrollment ? enrollmentStartupUncertain : authStartupUncertain)
+            throw new InvalidOperationException("Factory disposal after uncertain startup cannot prove actual entrypoint exit; retain exact backend ownership.");
+    }
