+
+[Collection("Ordinary Accounting financial HTTP")]
+public sealed class AccountingFinancialHttpTests(AccountingFinancialFixture fixture)
+{
+    [Theory]
+    [InlineData("legacy-auth")]
+    [InlineData("legacy-quotation")]
+    public async Task OrdinaryAccounting_ActualFinancialHttpReadRequiresLiveNormalBindingAndRevocationWins(string caller)
+    {
+        using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(30));
+        using var operatorClient = await fixture.CreateOperatorClientAsync(deadline.Token);
+        var principal = caller == "legacy-auth" ? fixture.AuthPrincipal : fixture.QuotationPrincipal;
+        var secret = caller == "legacy-auth" ? OrdinaryFinancialFixture.ClientSecret : OrdinaryFinancialFixture.QuotationSecret;
+        var credential = await fixture.LoginServiceAsync(fixture.Auth, caller, secret, "service/login", deadline.Token);
+        Guid? binding = await fixture.GrantAsync(operatorClient, principal, fixture.FinancialRole, null, DateTime.UtcNow.AddMinutes(2), deadline.Token);
+        Exception? failure = null;
+        try
+        {
+            var before = await fixture.AccountingFinancialStateAsync(deadline.Token);
+            using var client = fixture.Accounting!.CreateClient();
+            var calls = fixture.AccountingCheckedSubjects.Count;
+            using (var response = await ReadAsync(client, credential, deadline.Token))
+            {
+                using var body = await OrdinaryFinancialFixture.ReadJsonAsync(response, HttpStatusCode.OK, deadline.Token);
+                Assert.Equal(fixture.FinancialOperation.ToString("D"), body.RootElement.GetProperty("OperationId").GetString());
+                Assert.Equal(fixture.FinancialReceipt!.InvoiceId, body.RootElement.GetProperty("InvoiceId").GetInt32());
+                Assert.Equal(fixture.FinancialReceipt.FinancialBinding, body.RootElement.GetProperty("FinancialBinding").GetString());
+                Assert.Equal("no-store", response.Headers.CacheControl!.ToString());
+                Assert.Equal("service:" + caller, Assert.Single(fixture.AccountingCheckedSubjects.Skip(calls)));
+                Assert.Equal("AccountingService", fixture.AccountingProfiles.Last());
+            }
+            await fixture.RevokeAsync(operatorClient, principal, binding.Value, deadline.Token);
+            binding = null;
+            calls = fixture.AccountingCheckedSubjects.Count;
+            using (var revoked = await ReadAsync(client, credential, deadline.Token))
+                Assert.Equal(HttpStatusCode.Forbidden, revoked.StatusCode);
+            Assert.Equal("service:" + caller, Assert.Single(fixture.AccountingCheckedSubjects.Skip(calls)));
+            Assert.Equal(before, await fixture.AccountingFinancialStateAsync(deadline.Token));
+        }
+        catch (Exception caught) { failure = caught; throw; }
+        finally
+        {
+            if (binding is not null)
+            {
+                using var cleanup = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+                try { await fixture.RevokeAsync(operatorClient, principal, binding.Value, cleanup.Token); }
+                catch (Exception cleanupFailure) when (failure is not null)
+                { throw new AggregateException("Actual financial HTTP assertion and binding cleanup failed.", failure, cleanupFailure); }
+            }
