+    private async Task WriteLedgerAsync<T>(T entry, CancellationToken cancellationToken = default)
+    {
+        var directory = Environment.GetEnvironmentVariable("ORDINARY_FINANCIAL_RESOURCE_LEDGER") ?? Path.Combine(AppContext.BaseDirectory, "ordinary-financial-resource-ledger");
