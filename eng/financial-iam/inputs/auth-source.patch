+    private void RequireHostsQuiescent()
+    {
+        if (authStartupUncertain || enrollmentStartupUncertain || accountingStartupUncertain)
+            throw new InvalidOperationException("Actual host entrypoint quiescence after failed/interrupted startup is unknown; preserve backend for exact external SDK-owner recovery.");
+        if ((Auth is not null && !authDisposal.Complete) || (EnrollmentAuth is not null && !enrollmentAuthDisposal.Complete)
+            || (Iam is not null && !Iam.IsQuiescent))
+            throw new InvalidOperationException("Actual owned host shutdown is incomplete; retain dependent keys, pools and backend.");
+        if (Accounting is not null && !accountingDisposal.Complete)
+            throw new InvalidOperationException("Actual owned Accounting shutdown is incomplete; retain dependent keys, pools and backend.");
+    }
