+    public async Task DisposeAsync()
+    {
+        Interlocked.Exchange(ref lifecycle, 2);
+        await OwnedCleanup.RunAsync(
+            [("AccountingHost", DisposeAccountingHostAsync),
+             ("IamHost", token => Iam is null ? Task.CompletedTask : Iam.DisposeAsync(token)),
+             ("AuthHost", token => DisposeAuthHostAsync(false, token)),
+             ("EnrollmentAuthHost", token => DisposeAuthHostAsync(true, token)),
+             ("AuthValidationRsa", _ => { RequireHostsQuiescent(); authValidationRsa?.Dispose(); authValidationRsa = null; return Task.CompletedTask; }),
+             ("EnrollmentAuthValidationRsa", _ => { RequireHostsQuiescent(); enrollmentAuthValidationRsa?.Dispose(); enrollmentAuthValidationRsa = null; return Task.CompletedTask; }),
+             ("FixtureRsa", _ => { RequireHostsQuiescent(); signing.Dispose(); return Task.CompletedTask; }),
+             ("OwnedPool", _ => { RequireHostsQuiescent(); if (ownedPool is not null) { try { NpgsqlConnection.ClearPool(ownedPool); } finally { ownedPool.Dispose(); ownedPool = null; } } return Task.CompletedTask; }),
+             ("AuthPool", _ => { RequireHostsQuiescent(); if (authPool is not null) { try { NpgsqlConnection.ClearPool(authPool); } finally { authPool.Dispose(); authPool = null; } } return Task.CompletedTask; }),
