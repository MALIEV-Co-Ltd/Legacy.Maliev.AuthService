+    [Fact]
+    public async Task NormalWebIdentityUserPolicy_CurrentInitialPasswordState_RechecksPreviouslyIssuedTokenWithoutMutatingIdentity()
+    {
+        await using var factory = await SelfIdentityFactory.CreateAsync(postgres);
+        using var client = factory.CreateClient();
+        client.DefaultRequestHeaders.Authorization = new("Bearer", factory.Token());
+        using var before = await client.GetAsync(Route);
+        Assert.Equal(HttpStatusCode.OK, before.StatusCode);
+
+        var row = await factory.Customers.Users.SingleAsync(value => value.Id == "customer-42");
+        var passwordHash = row.PasswordHash;
+        var securityStamp = row.SecurityStamp;
+        row.PasswordSetupRequired = true;
+        await factory.Customers.SaveChangesAsync();
+
+        using var denied = await client.GetAsync(Route);
+        Assert.Equal(HttpStatusCode.Forbidden, denied.StatusCode);
+        var deniedBody = await denied.Content.ReadAsStringAsync();
+        Assert.DoesNotContain("current@example.com", deniedBody);
+        Assert.DoesNotContain("+66812345678", deniedBody);
+        Assert.True(denied.Headers.CacheControl?.NoStore);
+        Assert.True(denied.Headers.CacheControl?.Private);
+        Assert.False(denied.Headers.Contains("Set-Cookie"));
+        await factory.Customers.Entry(row).ReloadAsync();
+        Assert.True(row.PasswordSetupRequired);
+        Assert.Equal(passwordHash, row.PasswordHash);
+        Assert.Equal(securityStamp, row.SecurityStamp);
+        Assert.Equal(42, row.DatabaseID);
+
+        row.PasswordSetupRequired = false;
+        await factory.Customers.SaveChangesAsync();
+        using var restored = await client.GetAsync(Route);
+        Assert.Equal(HttpStatusCode.OK, restored.StatusCode);
+        using var json = JsonDocument.Parse(await restored.Content.ReadAsStringAsync());
+        Assert.Equal(42, json.RootElement.GetProperty("customerId").GetInt32());
+        Assert.Equal("current@example.com", json.RootElement.GetProperty("email").GetString());
+        await factory.Customers.Entry(row).ReloadAsync();
+        Assert.False(row.PasswordSetupRequired);
+        Assert.Equal(passwordHash, row.PasswordHash);
+        Assert.Equal(securityStamp, row.SecurityStamp);
+    }
